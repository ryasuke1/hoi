<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:simpleType name="genderType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="male"/>
            <xs:enumeration value="female"/>
            <xs:enumeration value="unknown"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="linkType">
        <xs:attribute name="ref" type="xs:IDREF"/>
        <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>

    <xs:complexType name="parentsType">
        <xs:sequence>
            <xs:element name="father" type="linkType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="mother" type="linkType" minOccurs="0" maxOccurs="1"/>
            <xs:element name="parent" type="linkType" minOccurs="0" maxOccurs="2"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="childrenType">
        <xs:sequence>
            <xs:element name="son" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="daughter" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="child" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="declaredCount" type="xs:nonNegativeInteger"/>
    </xs:complexType>

    <xs:complexType name="siblingsType">
        <xs:sequence>
            <xs:element name="brother" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="sister" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="sibling" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="declaredCount" type="xs:nonNegativeInteger"/>
    </xs:complexType>

    <xs:complexType name="spousesType">
        <xs:sequence>
            <xs:element name="wife" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="husband" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="spouse" type="linkType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="personType">
        <xs:sequence>
            <xs:element name="firstName" type="xs:string" minOccurs="0"/>
            <xs:element name="lastName" type="xs:string" minOccurs="0"/>
            <xs:element name="gender" type="genderType" minOccurs="0"/>
            <xs:element name="spouses" type="spousesType" minOccurs="0"/>
            <xs:element name="parents" type="parentsType" minOccurs="0"/>
            <xs:element name="children" type="childrenType" minOccurs="0"/>
            <xs:element name="siblings" type="siblingsType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="sourceKey" type="xs:string"/>
        <xs:attribute name="rawName" type="xs:string"/>
    </xs:complexType>

    <xs:element name="people">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="person" type="personType" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="count" type="xs:nonNegativeInteger" use="required"/>
        </xs:complexType>
        <xs:unique name="uniquePersonId">
            <xs:selector xpath="person"/>
            <xs:field xpath="@id"/>
        </xs:unique>
    </xs:element>

</xs:schema>
